 "doctype": "Print Format",
 "font_size": 14,
 "html": "<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/bootstrap@4.0.0/dist/css/bootstrap.min.css\"\n    integrity=\"sha384-Gn5384xqQ1aoWXA+058RXPxPg6fy4IWvTNh0E263XmFcJlSAwiGgFAW/dAiS6JXm\" crossorigin=\"anonymous\">\n<div class=\"container border\">\n    <div class=\"row\">\n        <div class=\"col-md-2 text-left\">\n            <img src=\"/assets/erpnext/images/mphatek_logo.png\" alt=\"logo\" width=\"170px\" >\n         </div>\n        <div class=\"col-md-10 justify-content-center text-center\">\n            <h5 class=\"font-weight-bold m-0\">MPHATEK SYSTEM PRIVATE LIMITED</h5>\n            <div class=\"text-center\">\n                <small>S.No.106, Temple, Pride Silicon Plaza, 5th Floor, B Wing, Senapati Bapat Rd,<br> Chattushringi, Pune,\n                Maharashtra 411016</small>\n            </div>\n            <div class=\"col-12\">\n                <b class=\"font-weight-bold\">Payslip for the month of {{ frappe.utils.get_datetime(doc.start_date).strftime('%B %Y') }}</b>\n            </div>\n        </div>\n    </div>\n\n    <div class=\"row justify-content-center border\">\n        <div class=\"col-5\">\n            <table class=\"table table-bordered table-hover\">\n                <tr>\n                    <td class=\"\" data-fieldname=\"employee_name\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Name</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"employee_name\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.employee_name}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"designation\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Designation</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"designation\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.designation}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"department\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Department</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"department\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.department}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"total_working_days\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Total Working Days</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"total_working_days\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.total_working_days}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"payment_days\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Payment Days</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"payment_days\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.payment_days}}</div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n        <div class=\"col-5\">\n            <table class=\"table table-bordered table-hover\">\n                <tr>\n                    <td class=\"\" data-fieldname=\"employee\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Employee Id</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"employee\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.employee}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"bank_name\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Bank Name</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"bank_name\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.bank_name}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"bank_account_no\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Bank Account No.</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"bank_account_no\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.bank_account_no}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"start_date\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">Start Date</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"start_date\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.start_date}}</div>\n                    </td>\n                </tr>\n                <tr>\n                    <td class=\"\" data-fieldname=\"end_date\" data-fieldtype=\"Table\">\n                        <div class=\"font-weight-bold value\">End Date</div>\n                    </td>\n                    <td class=\"text-right\" data-fieldname=\"end_date\" data-fieldtype=\"Table\">\n                        <div class=\"value\">{{doc.end_date}}</div>\n                    </td>\n                </tr>\n            </table>\n        </div>\n    </div>\n\n    <div class=\"row justify-content-center border\">\n        <div class=\"col-5\">\n            <table class=\"table table-hover table-bordered\" border=\"1\">\n                <thead>\n                    <tr>\n                        <th colspan=\"3\" class=\"font-weight-bold\">Earnings</th>\n                    </tr>\n                    <tr>\n                        <th style=\"width: auto;\" class=\"\" data-fieldname=\"earnings\" data-fieldtype=\"Table\">Component</th>\n                        <th style=\"width: auto;\" class=\"\" data-fieldname=\"earnings\" data-fieldtype=\"Table\">Master</th>\n                        <th style=\"width: auto;\" class=\"text-right\" data-fieldname=\"earnings\" data-fieldtype=\"Table\">Amount</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for earning in doc.earnings %}\n                    {% if earning.do_not_include_in_total == 0 %}\n                    <tr>\n                        <td class=\"\" data-fieldname=\"earnings\" data-fieldtype=\"Table\">\n                            <div class=\"font-weight-bold value\">{{earning.salary_component}}</div>\n                        </td>\n                        <td class=\"text-right\" data-fieldname=\"earnings\" data-fieldtype=\"Table\">\n                            <div class=\"value\">{{earning.get_formatted('default_amount', earning)}}</div>\n                        </td>\n                        <td class=\"text-right\" data-fieldname=\"earnings\" data-fieldtype=\"Table\">\n                            <div class=\"value\">{{earning.get_formatted('amount', earning)}}</div>\n                        </td>\n                    </tr>\n                    {% endif %}\n                    {% endfor %}\n                    <tr class=\"text-right\">\n                        <td colspan=\"3\"><b>&#8377;{{doc.gross_pay}}</b></td>\n                    </tr>\n                </tbody>\n            </table>\n        </div>\n        <div class=\"col-5\">\n            <table class=\"table table-hover table-bordered\" border=\"1\">\n                <thead>\n                    <tr>\n                        <th colspan=\"2\" class=\"font-weight-bold\">Deductions</th>\n                    </tr>\n                    <tr>\n                        <th style=\"width: 130px;\" class=\"\" data-fieldname=\"deductions\" data-fieldtype=\"Table\">Component</th>\n                        <th style=\"width: 130px;\" class=\"text-right\" data-fieldname=\"deductions\" data-fieldtype=\"Table\">Amount</th>\n                    </tr>\n                </thead>\n                <tbody>\n                    {% for deduction in doc.deductions %}\n                    {% if deduction.do_not_include_in_total == 0 and deduction.amount > 0 %}\n                    <tr>\n                        <td class=\"\" data-fieldname=\"deductions\" data-fieldtype=\"Table\">\n                            <div class=\"font-weight-bold value\">{{deduction.salary_component}}</div>\n                        </td>\n                        <td class=\"text-right\" data-fieldname=\"deductions\" data-fieldtype=\"Table\">\n                            <div class=\"value\">{{deduction.get_formatted('amount', deduction)}}</div>\n                        </td>\n                    </tr>\n                    {% endif %}\n                    {% endfor %}\n                    <tr class=\"text-right\">\n                        <td colspan=\"2\"><b>&#8377;{{doc.total_deduction}}</b></td>\n                    </tr>\n    \n                </tbody>\n            </table>\n        </div>\n    </div>\n\n    <div class=\"row border\">\n        <div class=\"col-12\">\n            <table class=\"table table-bordered\">\n                <!-- <tr>\n                    <td>\n                        <div class=\"font-weight-bold value\">Total Earnings: <b>\u20b9{{doc.gross_pay}}</b></div>\n                        <br>\n                        <div class=\"font-weight-bold value\">Total Deductions: <b>\u20b9{{doc.total_deduction}}</b></div>\n                    </td>\n                </tr> -->\n                <tr>\n                    <td>\n                        <span class=\"font-weight-bold value\">Net Pay for the month (Total Earnings - Total Deductions): <b>\u20b9{{doc.net_pay}}</b></span>\n                        <br>\n                        <span class=\"font-italic\">({{doc.total_in_words}})</span>\n                    </td>\n                </tr>\n            </table>\n        </div>\n    </div>\n    \n    <hr style=\"border: 2px solid black; margin: 1em 0;\">\n    <div style=\"text-align: center;\">\n        <div><b>mPHATEK Systems Private Limited</b></div>\n    </div>\n    <div class=\"text-center\" style=\"margin-top: 50px;\">\n        <p><mark style=\"background: rgb(231, 250, 162);\">\"This is a system generated payslip and does not require signature.\"</mark></p>\n    </div>\n</div>\n",
